/* 容器样式 */
.profile-container {
  padding: 40rpx;
  min-height: 100vh;
  background-color: #1a1a2e; /* 深色背景 */
  background-image: url('data:image/svg+xml;base64,'); /* 几何网格背景 */
  background-size: 20rpx 20rpx;
  color: #e0e0e0; /* 默认文本颜色 */
}

/* 用户信息卡片 */
.user-info-card {
  background: rgba(30, 30, 50, 0.8); /* 半透明深色背景 */
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 0 20rpx rgba(0, 255, 255, 0.4), 0 0 20rpx rgba(255, 0, 255, 0.4); /* 霓虹发光效果 */
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(0, 255, 255, 0.3);
}

.avatar-section {
  margin-bottom: 40rpx;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #00ffff; /* 霓虹边框 */
  box-shadow: 0 0 15rpx #00ffff; /* 霓虹发光 */
}

.nickname-section {
  margin-bottom: 50rpx;
}

.nickname-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #00ffff; /* 霓虹色 */
  text-shadow: 0 0 8rpx #00ffff; /* 文本发光 */
}

.action-section {
  width: 100%;
}

.edit-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(45deg, #ff00ff, #00ffff); /* 霓虹渐变 */
  color: white;
  border-radius: 40rpx;
  font-size: 32rpx;
  border: none;
  box-shadow: 0 0 15rpx rgba(255, 0, 255, 0.7), 0 0 15rpx rgba(0, 255, 255, 0.7); /* 霓虹发光 */
  transition: all 0.3s ease;
}

.edit-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
  box-shadow: 0 0 20rpx rgba(255, 0, 255, 1), 0 0 20rpx rgba(0, 255, 255, 1); /* 点击时更亮 */
}

/* 浮窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7); /* 更深的遮罩 */
  z-index: 999;
}

.modal-dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #1a1a2e; /* 浮窗背景与主背景一致 */
  border-radius: 24rpx;
  z-index: 1000;
  box-shadow: 0 0 25rpx rgba(0, 255, 255, 0.6), 0 0 25rpx rgba(255, 0, 255, 0.6); /* 霓虹发光 */
  border: 1rpx solid rgba(0, 255, 255, 0.4);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 30rpx;
  border-bottom: 1rpx solid #2b2b4f; /* 深色边框 */
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #00ffff; /* 霓虹色 */
  text-shadow: 0 0 8rpx #00ffff;
}

.modal-close {
  font-size: 44rpx;
  color: #ff00ff; /* 霓虹色 */
  text-shadow: 0 0 8rpx #ff00ff;
}

.modal-content {
  padding: 40rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 32rpx;
  color: #00ffff; /* 霓虹色 */
  margin-bottom: 20rpx;
  font-weight: 500;
  text-shadow: 0 0 5rpx #00ffff;
}

.avatar-upload-btn {
  padding: 0;
  background: transparent;
  border: none;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-upload-btn::after {
  border: none;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #ff00ff; /* 霓虹边框 */
  box-shadow: 0 0 15rpx #ff00ff; /* 霓虹发光 */
}

.nickname-input {
  height: 80rpx;
  border: 1rpx solid #00ffff; /* 霓虹边框 */
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
  background-color: #2b2b4f; /* 输入框背景 */
  color: #e0e0e0; /* 输入文字颜色 */
  box-shadow: 0 0 8rpx rgba(0, 255, 255, 0.5);
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 40rpx 40rpx;
  border-top: 1rpx solid #2b2b4f; /* 深色边框 */
}

.btn-cancel, .btn-confirm {
  width: 48%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  transition: all 0.3s ease;
}

.btn-cancel {
  background: #2b2b4f; /* 深色背景 */
  color: #00ffff; /* 霓虹色 */
  border: 1rpx solid #00ffff; /* 霓虹边框 */
  box-shadow: 0 0 10rpx rgba(0, 255, 255, 0.5);
}

.btn-cancel:active {
  opacity: 0.8;
  transform: scale(0.98);
  box-shadow: 0 0 15rpx rgba(0, 255, 255, 1);
}

.btn-confirm {
  background: linear-gradient(45deg, #00ff00, #00ffff); /* 霓虹渐变 */
  color: white;
  border: none;
  box-shadow: 0 0 15rpx rgba(0, 255, 0, 0.7), 0 0 15rpx rgba(0, 255, 255, 0.7); /* 霓虹发光 */
}

.btn-confirm:active {
  opacity: 0.8;
  transform: scale(0.98);
  box-shadow: 0 0 20rpx rgba(0, 255, 0, 1), 0 0 20rpx rgba(0, 255, 255, 1); /* 点击时更亮 */
}

/* 提示信息 */
.toast-message {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 255, 255, 0.2); /* 半透明霓虹背景 */
  color: #00ffff; /* 霓虹色 */
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  opacity: 0;
  transition: opacity 0.3s;
  z-index: 1001;
  border: 1rpx solid #00ffff;
  box-shadow: 0 0 15rpx rgba(0, 255, 255, 0.7);
}

.toast-message.show {
  opacity: 1;
}

/* 新增功能区域样式 */
.function-section {
  margin-top: 40rpx;
  background: rgba(30, 30, 50, 0.8); /* 半透明深色背景 */
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 0 20rpx rgba(255, 0, 255, 0.4), 0 0 20rpx rgba(0, 255, 255, 0.4); /* 霓虹发光效果 */
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* 按钮之间的间距 */
  border: 1rpx solid rgba(255, 0, 255, 0.3);
}

.function-btn {
  width: 100%;
  height: 88rpx; /* 增加高度 */
  line-height: 48rpx; /* 减小行高 */
  padding: 20rpx 0; /* 添加内边距 */
  background: linear-gradient(45deg, #ff00ff, #00ffff);
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  box-shadow: 0 0 15rpx rgba(255, 0, 255, 0.7), 0 0 15rpx rgba(0, 255, 255, 0.7);
  transition: all 0.3s ease;
  pointer-events: auto; /* 确保点击事件生效 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.function-btn:active {
  opacity: 0.8;
  box-shadow: 0 0 20rpx rgba(255, 0, 255, 1), 0 0 20rpx rgba(0, 255, 255, 1);
  transform: translateY(2rpx); /* 改用 translateY 代替 scale */
}

.edit-btn {
  width: 100%;
  height: 88rpx; /* 增加高度 */
  line-height: 48rpx; /* 减小行高 */
  padding: 20rpx 0; /* 添加内边距 */
  background: linear-gradient(45deg, #ff00ff, #00ffff);
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  box-shadow: 0 0 15rpx rgba(255, 0, 255, 0.7), 0 0 15rpx rgba(0, 255, 255, 0.7);
  transition: all 0.3s ease;
  pointer-events: auto; /* 确保点击事件生效 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-btn:active {
  opacity: 0.8;
  box-shadow: 0 0 20rpx rgba(255, 0, 255, 1), 0 0 20rpx rgba(0, 255, 255, 1);
  transform: translateY(2rpx); /* 改用 translateY 代替 scale */
}

/* EMG 数据展示区域样式 */
.emg-data-section {
  margin-top: 20px;
  padding: 15px;
  background-color: rgba(30, 30, 30, 0.8);
  border-radius: 10px;
  border: 1px solid #00ffcc;
  box-shadow: 0 0 10px rgba(0, 255, 204, 0.5);
}

.section-title {
  font-size: 16px;
  color: #00ffcc;
  margin-bottom: 10px;
}

.emg-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
}

.emg-table-header, .emg-table-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 20rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.emg-table-cell {
  word-break: break-all;
  padding: 10rpx;
  font-size: 28rpx;
  color: #fff;
}

.emg-time-cell {
  flex: 1;
  text-align: center;
}

.emg-value-cell {
  flex: 5;
  text-align: left;
  padding-left: 20rpx;
}

.emg-table-row:nth-child(even) {
  background-color: rgba(0, 255, 204, 0.05);
}

.emg-table-row td {
  padding: 8px;
  text-align: center;
  color: #ffffff;
}

/* EMG 数据输入区域样式 */
.emg-input-section {
  margin-top: 20px;
  padding: 15px;
  background-color: rgba(30, 30, 30, 0.8);
  border-radius: 10px;
  border: 1px solid #ff00ff;
  box-shadow: 0 0 10px rgba(255, 0, 255, 0.5);
}

.emg-input {
  width: 100%;
  height: 100px;
  padding: 10px;
  margin-bottom: 10px;
  background-color: rgba(0, 0, 0, 0.5);
  border: 1px solid #ff00ff;
  border-radius: 5px;
  color: #ffffff;
  font-size: 14px;
}

.emg-input-btn {
  display: flex;
  justify-content: space-between;
}

.emg-confirm-btn, .emg-cancel-btn {
  width: 48%;
  padding: 8px;
  border-radius: 5px;
  font-size: 14px;
  text-align: center;
}

.emg-confirm-btn {
  background-color: rgba(0, 255, 204, 0.8);
  color: #000000;
}

.emg-cancel-btn {
  background-color: rgba(255, 0, 255, 0.8);
  color: #000000;
}