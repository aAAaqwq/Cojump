<!-- 个人信息展示面板 -->
<view class="profile-container">
  <view class="user-info-card">
    <!-- 头像展示 -->
    <view class="avatar-section">
      <image class="avatar-image" src="{{tempAvatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
    </view>
    
    <!-- 昵称展示 -->
    <view class="nickname-section">
      <text class="nickname-text">{{userInfo.nickName || '微信用户'}}</text>
    </view>
    
    <!-- 修改按钮 -->
    <view class="action-section">
      <button class="edit-btn" bindtap="showEditModal">修改个人信息</button>
    </view>
  </view>

  <!-- EMG功能区域 -->
  <view class="function-section">
    <button class="function-btn" bindtap="onQueryEMGData">查询EMG数据</button>
    <button class="function-btn" bindtap="onSetEMGData">设置EMG数据</button>
  </view>

  <!-- EMG数据展示区域 -->
  <view class="emg-data-section" wx:if="{{showEMGDataTable}}">
    <view class="section-title">EMG 数据</view>
    <view class="emg-table">
      <view class="emg-table-header">
        <text class="emg-table-cell emg-time-cell">时间</text>
        <text class="emg-table-cell emg-value-cell">值</text>
        <text class="emg-table-cell emg-threshold-cell">阈值</text>
      </view>
      <block wx:for="{{emgData}}" wx:key="index">
        <view class="emg-table-row">
          <text class="emg-table-cell emg-time-cell">{{item.timestamp}}</text>
          <text class="emg-table-cell emg-value-cell">{{item.emg_raw}}</text>
          <text class="emg-table-cell emg-threshold-cell">{{item.threshold || '-'}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- EMG数据设置区域 -->
  <view class="emg-input-section" wx:if="{{showEMGInput}}">
    <view class="section-title">设置 EMG 数据</view>
    <form class="emg-form">
      <!-- 设备ID输入 -->
      <view class="form-item">
        <text class="form-label">设备ID</text>
        <input class="form-input" type="text" placeholder="请输入设备ID" bindinput="onDeviceIdInput" value="{{emgDeviceId}}"/>
      </view>
      
      <!-- EMG原始值数组输入 -->
      <view class="form-item">
        <text class="form-label">EMG原始值数组 (浮点数数组，空格分隔)</text>
        <textarea class="emg-textarea" placeholder="请输入浮点数数组，例如：1.2 3.4 5.6" bindinput="onEMGInput" value="{{emgInputArrayStr}}"></textarea>
      </view>
      
      <!-- 阈值输入 -->
      <view class="form-item">
        <text class="form-label">阈值</text>
        <input class="form-input" type="digit" placeholder="请输入阈值" bindinput="onThresholdInput" value="{{emgThreshold}}"/>
      </view>
      
      <!-- 按钮区域 -->
      <view class="form-buttons">
        <button class="function-btn confirm-btn" bindtap="onConfirmSetEMGData">确认设置</button>
        <button class="function-btn cancel-btn" bindtap="onCancelSetEMGData">取消</button>
      </view>
    </form>
  </view>

  <!-- 编辑浮窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal"></view>
  
  <view class="modal-dialog" wx:if="{{showModal}}">
    <view class="modal-header">
      <text class="modal-title">修改个人信息</text>
      <text class="modal-close" bindtap="hideModal">×</text>
    </view>
    
    <view class="modal-content">
      <!-- 头像修改 -->
      <view class="form-item">
        <text class="form-label">头像</text>
        <button class="avatar-upload-btn" open-type="chooseAvatar"  bindchooseavatar="onChooseAvatar">
          <image class="avatar-preview" src="{{tempAvatarUrl}}" mode="aspectFill"></image>
        </button>
      </view>
      
      <!-- 昵称修改 -->
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input 
          class="nickname-input" 
          type="nickname" 
          value="{{tempNickname}}" 
          placeholder="请输入昵称"
          bindinput="onNicknameInput"
        />
      </view>
    </view>
    
    <view class="modal-footer">
      <button class="btn-cancel" bindtap="hideModal">取消</button>
      <button class="btn-confirm" bindtap="saveProfile">保存</button>
    </view>
  </view>

  <!-- 保存成功提示 -->
  <view class="toast-message {{showToast ? 'show' : ''}}">
    <text>保存成功</text>
  </view>

  
</view>