
  .videoWrap {
    margin-top: 150rpx;
    word-wrap: break-word;
    position: relative;
    width: 80%;
    margin-left: 10%;
    background: #FFFFFF;
    box-shadow: 0 2px 16px 2px rgba(0, 0, 0, 0.1);
    padding: 50rpx 60rpx;
    box-sizing: border-box;
    min-height: 260rpx;
    border: 2px solid #333; /* 添加一个明显的外框 */
   border-radius: 5px; /* 设置边框的圆角半径 */
   background-color: #ffffff; /* 设置背景颜色，使其更显眼 */
  }

  