/**baidu.wxss - 语音识别样式优化**/

.voice-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #fef5f5 0%, #fce8e8 100%);
  padding: 40rpx;
  padding-bottom: 80rpx;
}

/* ==================== 页面标题卡片 ==================== */
.page-header {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  animation: slideInDown 0.8s ease;
}

@keyframes slideInDown {
  from {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.page-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15));
}

.page-header-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
}

/* ==================== 识别结果卡片 ==================== */
.result-card {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease 0.1s both;
}

.card-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx 24rpx 0 0;
}

.card-header-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.card-header-title {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.card-content {
  padding: 32rpx;
}

.result-display {
  position: relative;
  min-height: 300rpx;
}

.result-textarea {
  width: 100%;
  min-height: 300rpx;
  background: #fef5f5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #2c3e50;
  line-height: 1.8;
  border: 2rpx solid #fce8e8;
  box-sizing: border-box;
}

.empty-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #bdc3c7;
}

/* ==================== 录音控制卡片 ==================== */
.control-card {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease 0.2s both;
}

.control-card .card-header {
  background: linear-gradient(135deg, #56ab2f 0%, #a8e063 100%);
}

/* 录音状态指示 */
.recording-status {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.recording-status.active {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
  border-color: #f5576c;
}

.status-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
}

.pulse-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #95a5a6;
  margin-right: 16rpx;
  transition: all 0.3s ease;
}

.pulse-dot.recording {
  background: #f5576c;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.7;
  }
}

.status-text {
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: 600;
}

/* 按钮组 */
.button-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 优化后的语音按钮 */
.voice-btn {
  width: 100%;
  height: 110rpx;
  border-radius: 20rpx;
  border: none;
  padding: 0;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: all 0.3s ease;
  position: relative;
}

.voice-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.voice-btn:active::before {
  left: 100%;
}

.start-btn {
  background: linear-gradient(135deg, #56ab2f 0%, #a8e063 100%);
}

.stop-btn {
  background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
}

.recognize-btn {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.voice-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  height: 100%;
  color: #ffffff;
  position: relative;
  z-index: 1;
}

.btn-inner-icon {
  font-size: 44rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
  flex-shrink: 0;
}

.btn-inner-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}

.btn-inner-main {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.btn-inner-sub {
  font-size: 22rpx;
  opacity: 0.9;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

/* ==================== 使用说明卡片 ==================== */
.instruction-card {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease 0.3s both;
}

.instruction-card .card-header {
  background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
}

.instruction-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ecf0f1;
}

.instruction-item:last-child {
  border-bottom: none;
}

.instruction-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(247, 151, 30, 0.3);
}

.instruction-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.instruction-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.instruction-desc {
  font-size: 26rpx;
  color: #7f8c8d;
  line-height: 1.6;
}

/* ==================== 底部提示 ==================== */
.bottom-tips {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  margin-top: 40rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  animation: fadeIn 0.8s ease 0.4s both;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 26rpx;
  color: #7f8c8d;
  line-height: 1.8;
  flex: 1;
}

/* ==================== 动画定义 ==================== */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
