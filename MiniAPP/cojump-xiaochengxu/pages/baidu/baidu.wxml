
<view class="container">
  <image src="/image/KANG_YU.png" mode="widthFix" style="width: 300px; height: auto;"></image>
  <view style="height: 30px;"></view><view class="videoWrap" style="position: relative; left: -38rpx; top: -162rpx">
  <textarea placeholder='等待说话...' value='{{content}}' style="width: 512rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx"></textarea>
  </view>
  <button type="primary" style="margin-top: 20px; position: relative; left: 1rpx; top: -102rpx" bindtap="touchStart">开始录音</button>
  <button type="warn"  style="margin-top: 20px; position: relative; left: 0rpx; top: -75rpx" bindtap="touchEnd">结束录音</button>
  <button type="default"  style="margin-top: 20px; position: relative; left: 0rpx; top: -75rpx" bindtap="shibie">识别录音</button>
</view>