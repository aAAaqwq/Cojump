/**page1.wxss - 肌力训练模式样式优化**/

.training-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #f8f9fa 0%, #e9ecef 100%);
  padding: 40rpx;
  padding-bottom: 80rpx;
  position: relative;
}

/* ==================== 页面标题卡片 ==================== */
.page-header {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  animation: slideInDown 0.8s ease;
}

@keyframes slideInDown {
  from {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.page-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15));
}

.page-header-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
}

/* ==================== 模式选择卡片 ==================== */
.mode-selection-card {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease 0.1s both;
}

.card-header {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #ffffff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx 24rpx 0 0;
}

.card-header-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.card-header-title {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.card-content {
  padding: 5rpx;
}

/* 优化后的模式按钮 */
.btn-mode {
  width: 100%;
  height: 100rpx;
  border-radius: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 16rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: all 0.3s;
  position: relative;
}

.btn-mode:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn-mode.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.btn-mode.success {
  background: linear-gradient(135deg, #56ab2f 0%, #a8e063 100%);
}

.btn-mode.info {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.btn-mode-icon {
  font-size: 40rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
  position: absolute;
  left: 40rpx;
}

.btn-mode-text {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.btn-mode-main {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 1rpx;
  line-height: 1.3;
  text-align: center;
}

.btn-mode-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
  line-height: 1.3;
  text-align: center;
}

/* ==================== 时长设置卡片 ==================== */
.time-setting-card {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease 0.2s both;
}

.time-setting-card .card-header {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label-wrapper {
  margin-bottom: 16rpx;
}

.input-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  display: block;
  margin-bottom: 8rpx;
}

.input-hint {
  font-size: 24rpx;
  color: #95a5a6;
  display: block;
}

.modern-input-wrapper {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.modern-input-wrapper:focus-within {
  background: #ffffff;
  border-color: #667eea;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.input-prefix {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.modern-input {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  color: #2c3e50;
  background: transparent;
}

.input-suffix {
  font-size: 28rpx;
  color: #7f8c8d;
  font-weight: 500;
}

/* ==================== 倒计时显示 ==================== */
.countdown-display {
  background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  border: 2rpx dashed #667eea;
}

.countdown-label {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.countdown-value {
  font-size: 64rpx;
  font-weight: bold;
  color: #667eea;
  font-family: 'Courier New', monospace;
  margin: 16rpx 0;
  text-shadow: 0 4rpx 8rpx rgba(102, 126, 234, 0.2);
  letter-spacing: 4rpx;
}

.countdown-hint {
  font-size: 24rpx;
  color: #95a5a6;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ==================== 控制按钮卡片 ==================== */
.control-card {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease 0.3s both;
}

.control-card .card-header {
  background: linear-gradient(135deg, #56ab2f 0%, #a8e063 100%);
}

.control-buttons {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 25rpx;
  padding: 4%rpx;
}

/* 优化后的控制按钮 */
.btn-control {
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: all 0.3s;
}

.btn-control:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn-control.success {
  background: linear-gradient(135deg, #56ab2f 0%, #a8e063 100%);
  border: 2rpx solid rgba(86, 171, 47, 0.5);
}

.btn-control.warning {
  background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
  border: 2rpx solid rgba(247, 151, 30, 0.7);
  box-shadow: 0 8rpx 24rpx rgba(247, 151, 30, 0.4);
}

.btn-control-icon {
  font-size: 40rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
  margin-bottom: 4rpx;
}

.btn-control-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.btn-control-main {
  font-size: 20rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 1rpx;
  line-height: 1.3;
  text-align: center;
}

.btn-control-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
  line-height: 1.3;
  text-align: center;
}

/* ==================== 底部提示 ==================== */
.bottom-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  margin-top: 40rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  animation: fadeIn 0.8s ease 0.4s both;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #7f8c8d;
  line-height: 1.6;
}

/* ==================== 动画定义 ==================== */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
