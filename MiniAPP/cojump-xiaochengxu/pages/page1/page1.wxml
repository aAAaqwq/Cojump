<!--page1.wxml - 肌力训练模式优化-->
<view class="training-container">
  <!-- 页面标题卡片 -->
  <view class="page-header card">
    <text class="page-icon">💪</text>
    <view class="page-header-content">
      <text class="page-title">肌力训练模式</text>
      <text class="page-subtitle">Strength Training Mode</text>
    </view>
  </view>

  <!-- 模式选择卡片 -->
  <view class="mode-selection-card card">
    <view class="card-header">
      <text class="card-header-icon">⚙️</text>
      <text class="card-header-title">训练模式选择</text>
    </view>
    <view class="card-content">
      <button class="btn-mode primary" bindtap="mode1">
        <text class="btn-mode-icon">1️⃣</text>
        <view class="btn-mode-text">
          <text class="btn-mode-main">模式1</text>
          <text class="btn-mode-sub">Mode 1</text>
        </view>
      </button>
      <button class="btn-mode success" bindtap="mode2">
        <text class="btn-mode-icon">2️⃣</text>
        <view class="btn-mode-text">
          <text class="btn-mode-main">模式2</text>
          <text class="btn-mode-sub">Mode 2</text>
        </view>
      </button>
      <button class="btn-mode info" bindtap="mode3">
        <text class="btn-mode-icon">3️⃣</text>
        <view class="btn-mode-text">
          <text class="btn-mode-main">模式3</text>
          <text class="btn-mode-sub">Mode 3</text>
        </view>
      </button>
    </view>
  </view>

  <!-- 时长设置卡片 -->
  <view class="time-setting-card card">
    <view class="card-header">
      <text class="card-header-icon">⏱️</text>
      <text class="card-header-title">训练时长设置</text>
    </view>
    <view class="card-content">
      <view class="input-group">
        <view class="input-label-wrapper">
          <text class="input-label">训练时长（分钟）</text>
          <text class="input-hint">Please enter the time in minutes</text>
        </view>
        <view class="modern-input-wrapper">
          <text class="input-prefix">⏲️</text>
          <input 
            class="modern-input" 
            type="number" 
            placeholder="请输入训练时长" 
            bindinput="bindInput" 
            value="{{inputTime}}"
          />
          <text class="input-suffix">分钟</text>
        </view>
      </view>

      <!-- 倒计时显示 -->
      <view class="countdown-display" wx:if="{{timeStr}}">
        <view class="countdown-label">当前训练时长</view>
        <view class="countdown-value">{{timeStr}}</view>
        <view class="countdown-hint">Duration</view>
      </view>
    </view>
  </view>

  <!-- 控制按钮卡片 -->
  <view class="control-card card">
    <view class="card-header">
      <text class="card-header-icon">🎮</text>
      <text class="card-header-title">训练控制</text>
    </view>
    <view class="card-content">
      <view class="control-buttons">
        <button class="btn-control success" bindtap="start">
          <text class="btn-control-icon">▶️</text>
          <view class="btn-control-text">
            <text class="btn-control-main">开始</text>
            <text class="btn-control-sub">Start</text>
          </view>
        </button>
        <button class="btn-control warning" bindtap="pause">
          <text class="btn-control-icon">⏸️</text>
          <view class="btn-control-text">
            <text class="btn-control-main">暂停</text>
            <text class="btn-control-sub">Pause</text>
          </view>
        </button>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="bottom-tips">
    <text class="tips-icon">💡</text>
    <text class="tips-text">请在训练前确保已连接蓝牙设备</text>
  </view>
</view>
