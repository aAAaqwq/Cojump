/* pages/EMGtrain/EMGtrain.wxss */
/* 页面特定样式 */
.container{
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f7fa;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}
.phase-indicator {
  margin-top: 60rpx;
  margin-bottom: 40rpx;
}

.btn-group {
  display: flex;
  flex-direction: row;
  gap: 30rpx;
  margin-top: 40rpx;
}

.btn-train, .btn-stop {
  flex: 1;
  margin: 0;
}