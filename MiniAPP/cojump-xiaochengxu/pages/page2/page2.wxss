/**page2.wxss - 热身模式样式优化**/

.warmup-container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #fff5f5 0%, #ffe8e8 100%);
  padding: 40rpx;
  padding-bottom: 80rpx;
  position: relative;
}

/* ==================== 顶部Logo ==================== */
.top-logo {
  width: 180rpx;
  height: auto;
  display: block;
  margin: 0 auto 40rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.1));
  animation: fadeIn 0.8s ease;
}

/* ==================== 页面标题卡片 ==================== */
.page-header {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
  animation: slideInDown 0.8s ease;
}

@keyframes slideInDown {
  from {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.page-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15));
  animation: flicker 2s infinite;
}

@keyframes flicker {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.8; }
}

.page-header-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
}

/* ==================== 速度设置卡片 ==================== */
.speed-setting-card {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease 0.1s both;
}

.card-header {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #ffffff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx 24rpx 0 0;
}

.card-header-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.card-header-title {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.card-content {
  padding: 32rpx;
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label-wrapper {
  margin-bottom: 16rpx;
}

.input-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  display: block;
  margin-bottom: 8rpx;
}

.input-hint {
  font-size: 24rpx;
  color: #95a5a6;
  display: block;
}

.modern-input-wrapper {
  display: flex;
  align-items: center;
  background: #fff5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid #ffe8e8;
  transition: all 0.3s ease;
}

.modern-input-wrapper:focus-within {
  background: #ffffff;
  border-color: #f5576c;
  box-shadow: 0 0 0 6rpx rgba(245, 87, 108, 0.1);
}

.input-prefix {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.modern-input {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  color: #2c3e50;
  background: transparent;
}

.input-suffix {
  font-size: 28rpx;
  color: #f5576c;
  font-weight: 600;
}

/* ==================== 速度范围提示 ==================== */
.speed-range-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #f7971e15 0%, #ffd20015 100%);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  border: 2rpx dashed #f7971e;
}

.range-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.range-label {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-bottom: 8rpx;
}

.range-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #f7971e;
  font-family: 'Courier New', monospace;
}

.range-divider {
  color: #e9ecef;
  font-size: 32rpx;
  letter-spacing: -4rpx;
}

/* ==================== 控制按钮卡片 ==================== */
.control-card {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease 0.2s both;
}

.control-card .card-header {
  background: linear-gradient(135deg, #56ab2f 0%, #a8e063 100%);
}

.press-hold-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #56ab2f15 0%, #a8e06315 100%);
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  border: 2rpx dashed #56ab2f;
}

.hint-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.hint-subtitle {
  font-size: 24rpx;
  color: #7f8c8d;
  letter-spacing: 1rpx;
}

/* ==================== 长按启动按钮 ==================== */
.btn-press-hold {
  width: 100%;
  height: 200rpx;
  background: linear-gradient(135deg, #56ab2f 0%, #a8e063 100%);
  border-radius: 24rpx;
  border: none;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(86, 171, 47, 0.35);
  transition: all 0.3s ease;
}

.btn-press-hold::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.btn-press-hold:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(86, 171, 47, 0.4);
}

.btn-press-hold:active::before {
  left: 100%;
}

.btn-press-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #ffffff;
}

.btn-press-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15));
}

.btn-press-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.btn-press-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  letter-spacing: 1rpx;
}

.btn-press-effect {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
  opacity: 0;
  transition: opacity 0.3s;
}

.btn-press-hold:active .btn-press-effect {
  opacity: 1;
}

/* ==================== 使用说明卡片 ==================== */
.instruction-card {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.8s ease 0.3s both;
}

.instruction-card .card-header {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.instruction-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ecf0f1;
}

.instruction-item:last-child {
  border-bottom: none;
}

.instruction-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(79, 172, 254, 0.3);
}

.instruction-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.instruction-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.instruction-desc {
  font-size: 26rpx;
  color: #7f8c8d;
  line-height: 1.6;
}

/* ==================== 底部提示 ==================== */
.bottom-tips {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  margin-top: 40rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  animation: fadeIn 0.8s ease 0.4s both;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 26rpx;
  color: #7f8c8d;
  line-height: 1.8;
  flex: 1;
}

/* ==================== 动画定义 ==================== */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
