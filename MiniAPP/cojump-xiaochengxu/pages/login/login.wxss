/* login.wxss - COJUMP康复训练系统登录页样式（微信授权登录） */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx 40rpx;
}

/* 顶部波浪装饰 */
.wave-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 0 0 50% 50%;
  animation: wave 3s ease-in-out infinite;
}

@keyframes wave {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

/* Logo和品牌区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  z-index: 2;
  animation: fadeInDown 0.8s ease;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.logo-image {
  width: 180rpx;
  height: auto;
  margin-bottom: 48rpx;
  filter: drop-shadow(0 8rpx 24rpx rgba(0, 0, 0, 0.2));
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-16rpx);
  }
}

.brand-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.brand-name {
  font-size: 72rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 8rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
}

.brand-slogan {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 4rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.brand-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  z-index: 2;
  animation: slideUp 0.8s ease 0.2s both;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-title {
  text-align: center;
  margin-bottom: 60rpx;
}

.title-text {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.title-subtitle {
  display: block;
  font-size: 28rpx;
  color: #95a5a6;
  letter-spacing: 1rpx;
}

/* 微信登录区域 */
.wechat-login-section {
  width: 100%;
}

.wechat-login-btn {
  width: 100%;
  height: 140rpx;
  background: linear-gradient(135deg, #07c160 0%, #06a94d 100%);
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.4);
  transition: all 0.3s;
  padding: 0;
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.wechat-login-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.wechat-login-btn:active::before {
  left: 100%;
}

.wechat-login-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.btn-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 10rpx;
  position: relative;
  z-index: 1;
}

.wechat-icon {
  font-size: 56rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15));
  margin-bottom: 4rpx;
}

.wechat-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 3rpx;
}

.wechat-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
}

/* 登录提示 */
.login-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.tips-icon {
  font-size: 28rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #7f8c8d;
}

/* 协议链接 */
.agreement-links {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #7f8c8d;
}

.agreement-link {
  font-size: 24rpx;
  color: #4a90e2;
  font-weight: 600;
}

/* 底部信息 */
.footer-info {
  margin-top: auto;
  padding-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  z-index: 2;
}

.footer-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.footer-copyright {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 1rpx;
}
