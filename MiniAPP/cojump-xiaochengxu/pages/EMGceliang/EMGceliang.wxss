.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.card-header {
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 1rpx solid #eee;
}

.card-content {
  padding: 30rpx;
  display: flex;
  justify-content: center;
}

.btn {
  width: 80%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.primary {
  background-color: #007aff;
  color: #fff;
}

.progress-container {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.progress-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.step {
  padding: 20rpx 0;
}

.step-title {
  font-size: 28rpx;
  color: #007aff;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #eee;
  border-radius: 8rpx;
  margin: 20rpx 0;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #007aff;
  border-radius: 8rpx;
  transition: width 1s;
}

.timer {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 20rpx auto;
  display: block;
}

.result-card {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  padding: 30rpx;
}

.result-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.result-content {
  margin-bottom: 30rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.result-item:last-child {
  border-bottom: none;
}

.value {
  font-weight: bold;
  color: #007aff;
}

.apply-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #007aff;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.connected-device {
  text-align: center;
  margin-top: 30rpx;
}

.connected-text {
  font-size: 24rpx;
  color: #999;
}  