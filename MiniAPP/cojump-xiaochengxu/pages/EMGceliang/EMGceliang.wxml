<view class="container">
  <view class="page-title">
    阈值测量
  </view>
  <view class="card measure-card">
    <button class="main-btn start-btn" bindtap="startMeasurement" disabled="{{isMeasuring}}">
      {{isMeasuring ? '测量中...' : '立即测量'}}
    </button>
  </view>
  <view class="card progress-area">
    <view class="progress-header">测量进度</view>
    <view wx:if="{{currentStep === 1}}" class="progress-step">
      <text class="step-title">步骤 1/2 放松测量</text>
      <view class="progress-bar"><view class="progress-fill" style="width: {{(10-relaxTime)*10}}%"></view></view>
      <text class="highlight">剩余时间: {{relaxTime}}秒</text>
    </view>
    <view wx:if="{{currentStep === 2}}" class="progress-step">
      <text class="step-title">步骤 2/2 收缩测量</text>
      <view class="progress-bar"><view class="progress-fill" style="width: {{(5-contractTime)*20}}%"></view></view>
      <text class="highlight">剩余时间: {{contractTime}}秒</text>
    </view>
    <view wx:if="{{currentStep === 3}}" class="progress-step finish">
      <text class="step-title">测量完成</text>
      <image src="/images/success.png" class="success-icon"></image>
      <text class="highlight">请查看下方测量结果</text>
    </view>
  </view>
  <view class="card result-card">
    <view class="result-header">测量结果</view>
    <view class="result-row">
      <view class="result-col">
        <text class="result-label">放松阈值</text>
        <text class="result-value">{{relaxAvg}}</text>
      </view>
      <view class="result-col">
        <text class="result-label">用力阈值</text>
        <text class="result-value">{{contractAvg}}</text>
      </view>
      <view class="result-col">
        <text class="result-label">推荐阈值</text>
        <text class="result-value recommend">{{recommendAvg}}</text>
      </view>
    </view>
    <button class="main-btn apply-btn" bindtap="applyRecommendedThreshold">应用推荐阈值</button>
  </view>
</view>