/* userInfo.wxss - 个人信息页面样式 */

.userinfo-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 80rpx;
  position: relative;
}

/* ==================== 顶部背景 ==================== */
.header-bg {
  height: 400rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: linear-gradient(to bottom, transparent, #f5f7fa);
}

/* ==================== 用户头像区域 ==================== */
.avatar-section {
  position: relative;
  margin-top: -200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  animation: fadeInDown 0.8s ease;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.avatar-wrapper {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ffffff;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 24rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 88rpx;
  color: #667eea;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.user-name-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 40rpx;
}

.user-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #2c3e50;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.user-id {
  font-size: 24rpx;
  color: #7f8c8d;
  background: rgba(255, 255, 255, 0.9);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

/* ==================== 个人信息卡片 ==================== */
.info-card {
  margin: 0 40rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  animation: fadeInUp 0.8s ease 0.2s both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx 24rpx 0 0;
}

.card-header-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.card-header-title {
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.card-content {
  padding: 32rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ecf0f1;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #7f8c8d;
  font-weight: 500;
}

.info-value {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
}

/* ==================== 编辑信息按钮 ==================== */
.edit-section {
  margin: 0 40rpx 32rpx;
  animation: fadeInUp 0.8s ease 0.3s both;
}

.btn-edit {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(79, 172, 254, 0.35);
  transition: all 0.3s;
  position: relative;
}

.btn-edit:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(79, 172, 254, 0.3);
}

.btn-edit-icon {
  font-size: 36rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
  position: absolute;
  left: 32rpx;
}

.btn-edit-text {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding-left: 48rpx;
}

.btn-edit-main {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 1rpx;
  line-height: 1.3;
  text-align: center;
}

.btn-edit-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
  line-height: 1.3;
  text-align: center;
}

/* ==================== 退出登录 ==================== */
.logout-section {
  margin: 0 40rpx;
  animation: fadeInUp 0.8s ease 0.4s both;
}

.btn-logout {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  border: 2rpx solid #e74c3c;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s;
}

.btn-logout:active {
  background: #e74c3c;
}

.btn-logout-icon {
  font-size: 32rpx;
}

.btn-logout-text {
  font-size: 28rpx;
  color: #e74c3c;
  font-weight: 600;
}

.btn-logout:active .btn-logout-text {
  color: #ffffff;
}

/* ==================== 返回按钮 ==================== */
.back-btn {
  position: fixed;
  top: 50rpx;
  left: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.9));
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
  z-index: 999;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(102, 126, 234, 0.2);
}

.back-btn:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
}

