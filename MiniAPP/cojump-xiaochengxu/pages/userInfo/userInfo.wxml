<!--userInfo.wxml - 个人信息页面-->
<view class="userinfo-container">
  <!-- 顶部背景 -->
  <view class="header-bg"></view>

  <!-- 用户头像区域 -->
  <view class="avatar-section">
    <view class="avatar-wrapper">
      <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" class="avatar-image"></image>
      <view wx:else class="avatar-placeholder">👤</view>
    </view>
    <view class="user-name-wrapper">
      <text class="user-name">{{userInfo.nickName || '未设置昵称'}}</text>
      <text class="user-id">ID: {{userInfo._id || 'Unknown'}}</text>
    </view>
  </view>

  <!-- 个人信息卡片 -->
  <view class="info-card card">
    <view class="card-header">
      <text class="card-header-icon">👤</text>
      <text class="card-header-title">个人信息</text>
    </view>
    <view class="card-content">
      <view class="info-item">
        <text class="info-label">昵称</text>
        <text class="info-value">{{userInfo.nickName || '未设置'}}</text>
      </view>
      <view class="info-item" wx:if="{{userInfo.phone}}">
        <text class="info-label">手机号</text>
        <text class="info-value">{{userInfo.phone}}</text>
      </view>
      <view class="info-item" wx:if="{{userInfo.gender}}">
        <text class="info-label">性别</text>
        <text class="info-value">{{userInfo.gender === 1 ? '男' : userInfo.gender === 2 ? '女' : '未知'}}</text>
      </view>
      <view class="info-item" wx:if="{{userInfo.city}}">
        <text class="info-label">地区</text>
        <text class="info-value">{{userInfo.province}} {{userInfo.city}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">注册时间</text>
        <text class="info-value">{{createTimeStr}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">最后登录</text>
        <text class="info-value">{{lastLoginTimeStr}}</text>
      </view>
    </view>
  </view>

  <!-- 编辑信息按钮 -->
  <view class="edit-section">
    <button class="btn-edit" open-type="getUserInfo" bindgetuserinfo="updateUserInfo">
      <text class="btn-edit-icon">✏️</text>
      <view class="btn-edit-text">
        <text class="btn-edit-main">更新个人信息</text>
        <text class="btn-edit-sub">Update Profile</text>
      </view>
    </button>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="btn-logout" bindtap="logout">
      <text class="btn-logout-icon">🚪</text>
      <text class="btn-logout-text">退出登录</text>
    </button>
  </view>

  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text>←</text>
  </view>
</view>

