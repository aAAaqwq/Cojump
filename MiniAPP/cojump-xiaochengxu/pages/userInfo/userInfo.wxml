<!--userInfo.wxml - 个人信息页面-->
<view class="userinfo-container">
  <!-- 顶部背景 -->
  <view class="header-bg"></view>

  <!-- 用户头像区域 -->
  <view class="avatar-section">
    <view class="avatar-wrapper">
      <image wx:if="{{displayAvatarUrl}}" src="{{displayAvatarUrl}}" class="avatar-image"></image>
      <view wx:else class="avatar-placeholder">👤</view>
    </view>
    <view class="user-name-wrapper">
      <text class="user-name">{{userInfo.nickName || '未设置昵称'}}</text>
    </view>
  </view>

  <!-- 个人信息卡片 -->
  <view class="info-card card">
    <view class="card-header">
      <text class="card-header-icon">👤</text>
      <text class="card-header-title">个人信息</text>
    </view>
    <view class="card-content">
      <view class="info-item">
        <text class="info-label">昵称</text>
        <text class="info-value">{{userInfo.nickName || '未设置'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">注册时间</text>
        <text class="info-value">{{createTimeStr}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">最后登录</text>
        <text class="info-value">{{lastLoginTimeStr}}</text>
      </view>
    </view>
  </view>

  <!-- 编辑信息按钮 -->
  <view class="edit-section">
    <button class="btn-edit" bindtap="openEditModal">
      <text class="btn-edit-icon">✏️</text>
      <view class="btn-edit-text">
        <text class="btn-edit-main">修改个人信息</text>
        <text class="btn-edit-sub">Edit Profile</text>
      </view>
    </button>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="btn-logout" bindtap="logout">
      <text class="btn-logout-icon">🚪</text>
      <text class="btn-logout-text">退出登录</text>
    </button>
  </view>

  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text>←</text>
  </view>

  <!-- 个人信息修改弹窗 -->
  <view wx:if="{{showEditModal}}" class="modal-overlay" bindtap="closeEditModal" catchtouchmove="preventTouchMove">
    <view class="modal-container" catchtap="stopPropagation" catchtouchmove="preventTouchMove">
      <!-- 标题栏 -->
      <view class="modal-header">
        <view class="modal-title-wrapper">
          <text class="modal-icon">📝</text>
          <view class="modal-title-text">
            <text class="modal-title">修改个人信息</text>
            <text class="modal-subtitle">Update Profile Info</text>
          </view>
        </view>
        <view class="modal-close" bindtap="closeEditModal">
          <text class="close-icon">✕</text>
        </view>
      </view>

      <!-- 弹窗内容 -->
      <view class="modal-content">
        <!-- 头像选择区域 -->
        <view class="avatar-edit-section">
          <text class="section-label">头像 Avatar</text>
          <button class="avatar-select-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <view class="avatar-preview-wrapper">
              <image 
                wx:if="{{newAvatarUrl || displayAvatarUrl}}" 
                src="{{newAvatarUrl || displayAvatarUrl}}" 
                class="avatar-preview"
              ></image>
              <view wx:else class="avatar-preview-placeholder">👤</view>
              <view class="avatar-edit-badge">
                <text class="badge-icon">📷</text>
              </view>
            </view>
            <text class="avatar-hint">点击更换头像</text>
            <text class="avatar-hint-sub">Tap to Change Avatar</text>
          </button>
        </view>

        <!-- 昵称编辑区域 -->
        <view class="nickname-edit-section">
          <text class="section-label">昵称 Nickname</text>
          <view class="nickname-input-wrapper">
            <input 
              type="nickname" 
              class="nickname-input" 
              placeholder="{{userInfo.nickName || '请输入昵称'}}" 
              value="{{newNickName}}"
              bindinput="onNicknameInput"
              maxlength="12"
            />
            <text class="char-count">{{nickNameLength}}/12</text>
          </view>
          <text class="nickname-hint">建议使用真实姓名，方便医护人员识别</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="modal-actions">
        <button class="btn-modal-confirm" bindtap="confirmEdit" disabled="{{isUploading}}">
          <text wx:if="{{!isUploading}}" class="btn-modal-icon">✓</text>
          <view class="btn-modal-text">
            <text class="btn-modal-main">{{isUploading ? '上传中...' : '确认修改'}}</text>
            <text class="btn-modal-sub">{{isUploading ? uploadProgress + '%' : 'Confirm'}}</text>
          </view>
          <view wx:if="{{isUploading}}" class="upload-progress">
            <view class="progress-bar" style="width: {{uploadProgress}}%"></view>
          </view>
        </button>
        <button class="btn-modal-cancel" bindtap="closeEditModal">
          <text class="btn-modal-cancel-text">取消</text>
        </button>
      </view>
    </view>
  </view>
</view>
