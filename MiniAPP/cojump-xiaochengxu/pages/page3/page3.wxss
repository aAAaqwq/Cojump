/* pages/page3/page3.wxss */
.container {
  height: 100vh;
  background: #f8f9fa;
}

.status-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: 12rpx 24rpx;
  background: rgba(255, 193, 7, 0.1);
  color: #ffc107;
  font-size: 28rpx;
  z-index: 100;
}

.chart-container {
  height: calc(100vh - 120rpx);
  margin-top: 80rpx;
}

ec-canvas {
  width: 100%;
  height: 100%;
}
