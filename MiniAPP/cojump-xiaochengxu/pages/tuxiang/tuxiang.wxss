/* EMG阈值历史趋势图样式 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f8f9fa;
}

/* 标题栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #e5e5e5;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.refresh-btn {
  padding: 10rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  transition: background-color 0.3s;
}

.refresh-btn:active {
  background-color: #e0e0e0;
}

.refresh-icon {
  font-size: 32rpx;
}

/* 时间选择器 */
.time-selector {
  display: flex;
  background-color: #fff;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  border-radius: 0 0 20rpx 20rpx;
}

.time-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 20rpx;
  margin: 0 5rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  transition: all 0.3s;
}

.time-item.active {
  background-color: #5470c6;
  color: #fff;
  font-weight: bold;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #fff;
  margin: 0 30rpx;
  border-radius: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 无数据状态 */
.no-data-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #fff;
  margin: 0 30rpx;
  border-radius: 20rpx;
}

.no-data-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.no-data-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.no-data-desc {
  font-size: 26rpx;
  color: #999;
}

/* 图表容器 */
.chart-container {
  flex: 1;
  margin: 0 30rpx 30rpx;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

ec-canvas {
  width: 100%;
  height: 100%;
  min-height: 500rpx;
}
