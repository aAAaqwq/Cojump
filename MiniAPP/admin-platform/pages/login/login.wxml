<!--pages/login/login.wxml-->
<view class="login-container">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="circle circle-1"></view>
    <view class="circle circle-2"></view>
    <view class="circle circle-3"></view>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <!-- Logo和标题区域 -->
    <view class="header-section">
      <view class="logo-wrapper">
        <text class="logo-text">🔐</text>
      </view>
      <view class="title">管理员后台</view>
      <view class="subtitle">Admin Dashboard</view>
    </view>

    <!-- 表单区域 -->
    <view class="form-section">
      <!-- 账号输入框 -->
      <view class="input-group">
        <view class="input-wrapper {{focusUsername ? 'focused' : ''}}">
          <view class="input-icon">
            <text class="icon-text">👤</text>
          </view>
          <input 
            class="input-field" 
            type="text" 
            placeholder="请输入账号" 
            value="{{username}}"
            bindinput="onUsernameInput"
            bindfocus="onUsernameFocus"
            bindblur="onUsernameBlur"
          />
        </view>
      </view>

       <!-- 密码输入框 - 平台兼容方案 -->
       <view class="input-group">
         <view class="input-wrapper {{focusPassword ? 'focused' : ''}}">
           <view class="input-icon">
             <text class="icon-text">🔒</text>
           </view>
           <!-- 安卓平台：使用双input切换 -->
           <view wx:if="{{isAndroid}}" class="password-input-container">
             <!-- 隐藏密码的input -->
             <input 
               wx:if="{{!showPassword}}"
               class="input-field" 
               type="password" 
               placeholder="请输入密码" 
               value="{{password}}"
               bindinput="onPasswordInput"
               bindfocus="onPasswordFocus"
               bindblur="onPasswordBlur"
               id="passwordInput"
             />
             <!-- 显示密码的input -->
             <input 
               wx:else
               class="input-field" 
               type="text" 
               placeholder="请输入密码" 
               value="{{password}}"
               bindinput="onPasswordInput"
               bindfocus="onPasswordFocus"
               bindblur="onPasswordBlur"
               id="passwordInputText"
             />
           </view>
           <!-- iOS平台：使用-webkit-text-security -->
           <view wx:elif="{{isIOS}}" class="password-input-container">
             <input 
               class="input-field password-input-ios {{showPassword ? 'show-password' : 'hide-password'}}" 
               type="text" 
               placeholder="请输入密码" 
               value="{{password}}"
               bindinput="onPasswordInput"
               bindfocus="onPasswordFocus"
               bindblur="onPasswordBlur"
               id="passwordInputIOS"
             />
           </view>
           <!-- 其他平台：使用标准方案 -->
           <view wx:else class="password-input-container">
             <input 
               class="input-field" 
               type="{{showPassword ? 'text' : 'password'}}" 
               placeholder="请输入密码" 
               value="{{password}}"
               bindinput="onPasswordInput"
               bindfocus="onPasswordFocus"
               bindblur="onPasswordBlur"
               id="passwordInputDefault"
             />
           </view>
           <view class="eye-icon" catchtap="togglePassword">
             <text class="icon-text password-toggle-icon {{showPassword ? 'show' : 'hide'}}">
               {{showPassword ? '👁' : '🙈'}}
             </text>
           </view>
         </view>
       </view>

      <!-- 验证码输入框 -->
      <view wx:if="{{showCaptcha}}" class="input-group captcha-group">
        <view class="input-wrapper">
          <view class="input-icon">
            <text class="icon-text">🔢</text>
          </view>
          <input 
            class="input-field captcha-input" 
            type="text" 
            placeholder="请输入验证码" 
            value="{{captchaCode}}"
            bindinput="onCaptchaInput"
            maxlength="6"
          />
        </view>
        <view class="captcha-display">
          <view wx:if="{{!captchaLoading}}" class="captcha-number">
            <text class="captcha-text">{{captchaImage}}</text>
          </view>
          <view wx:else class="captcha-loading">
            <text>生成中...</text>
          </view>
          <view class="captcha-refresh" bindtap="refreshCaptcha">
            <text class="icon-text">🔄</text>
          </view>
        </view>
      </view>

      <!-- 记住密码 -->
      <view class="options-row">
        <view class="remember-box" bindtap="toggleRemember">
          <view class="checkbox {{rememberPassword ? 'checked' : ''}}">
            <view class="checkbox-inner" wx:if="{{rememberPassword}}"></view>
          </view>
          <text class="remember-text">记住密码</text>
        </view>
        <text class="forgot-text" bindtap="onForgotPassword">忘记密码?</text>
      </view>

      <!-- 登录按钮 -->
      <button class="login-btn {{loading ? 'loading' : ''}}" bindtap="onLogin" disabled="{{loading}}">
        <text wx:if="{{!loading}}">登 录</text>
        <view wx:else class="loading-spinner">
          <view class="spinner"></view>
          <text>登录中...</text>
        </view>
      </button>

      <!-- 开发工具测试按钮 -->
      <view wx:if="{{platform === 'devtools'}}" class="debug-section">
        <view class="debug-title">开发工具测试</view>
        <view class="debug-info">
          <text>当前平台: {{platform}}</text>
          <text>检测平台: {{isIOS ? 'iOS' : (isAndroid ? 'Android' : 'Other')}}</text>
          <text>设备型号: {{systemInfo.model || 'Unknown'}}</text>
        </view>
        <view class="debug-buttons">
          <button class="debug-btn" bindtap="testIOSMode">测试iOS模式</button>
          <button class="debug-btn" bindtap="testAndroidMode">测试安卓模式</button>
          <button class="debug-btn" bindtap="resetPlatform">重置检测</button>
        </view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="footer-section">
      <text class="footer-text">© 2025 Admin Platform. All rights reserved.</text>
    </view>
  </view>
</view>