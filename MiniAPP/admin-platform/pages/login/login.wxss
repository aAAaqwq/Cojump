/* pages/login/login.wxss */

/* 容器样式 */
.login-container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 背景装饰圆圈 */
.bg-decoration {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  animation: float 6s ease-in-out infinite;
}

.circle-1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -50rpx;
  animation-delay: 0s;
}

.circle-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: 100rpx;
  left: -50rpx;
  animation-delay: 2s;
}

.circle-3 {
  width: 150rpx;
  height: 150rpx;
  top: 50%;
  right: 20rpx;
  animation-delay: 4s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-20rpx) rotate(180deg);
  }
}

/* 登录卡片 */
.login-card {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 60rpx 50rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: slideUp 0.5s ease-out;
  backdrop-filter: blur(10rpx);
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头部区域 */
.header-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-wrapper {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.4);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.logo {
  width: 70rpx;
  height: 70rpx;
}

.logo-text {
  font-size: 60rpx;
  line-height: 1;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 2rpx;
}

/* 表单区域 */
.form-section {
  margin-bottom: 40rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
  position: relative;
  overflow: hidden;
}

.input-wrapper.focused {
  background: #fff;
  border-color: #667eea;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.15);
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-icon image {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.icon-text {
  font-size: 32rpx;
  line-height: 1;
  opacity: 0.7;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 44rpx;
  line-height: 44rpx;
}

.input-field::placeholder {
  color: #999;
}

/* 密码输入框容器 */
.password-input-container {
  flex: 1;
  position: relative;
  height: 44rpx;
}

/* iOS平台密码输入框样式 */
.password-input-ios {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 44rpx;
  line-height: 44rpx;
  transition: all 0.3s ease;
}

/* iOS隐藏密码样式 */
.password-input-ios.hide-password {
  -webkit-text-security: disc;
  -webkit-text-security: disc;
}

/* iOS显示密码样式 */
.password-input-ios.show-password {
  -webkit-text-security: none;
  -webkit-text-security: none;
}

/* 开发工具调试样式 */
.debug-section {
  margin-top: 30rpx;
  padding: 20rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.2);
}

.debug-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #667eea;
  margin-bottom: 15rpx;
  text-align: center;
}

.debug-info {
  margin-bottom: 20rpx;
}

.debug-info text {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  padding: 4rpx 0;
}

.debug-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  justify-content: center;
}

.debug-btn {
  flex: 1;
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.debug-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

.eye-icon {
  width: 60rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
  cursor: pointer;
  border-radius: 8rpx;
  transition: all 0.3s ease;
  position: relative;
  z-index: 10;
}

.eye-icon:active {
  background: rgba(102, 126, 234, 0.1);
  transform: scale(0.95);
}

.eye-icon image {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.password-toggle-icon {
  font-size: 32rpx;
  opacity: 0.8;
  transition: all 0.3s ease;
  display: inline-block;
  transform-origin: center;
}

.password-toggle-icon.show {
  opacity: 1;
  color: #667eea;
  animation: eyeOpen 0.3s ease-out;
}

.password-toggle-icon.hide {
  opacity: 0.7;
  color: #999;
  animation: eyeClose 0.3s ease-out;
}

@keyframes eyeOpen {
  0% {
    transform: scale(0.8) rotate(-10deg);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.1) rotate(5deg);
    opacity: 0.8;
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

@keyframes eyeClose {
  0% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
  50% {
    transform: scale(0.9) rotate(-5deg);
    opacity: 0.6;
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 0.7;
  }
}

/* 选项行 */
.options-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 0 4rpx;
}

.remember-box {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.checkbox.checked {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: #667eea;
}

.checkbox-inner {
  width: 12rpx;
  height: 20rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg) translateY(-2rpx);
}

.remember-text {
  font-size: 26rpx;
  color: #666;
}

.forgot-text {
  font-size: 26rpx;
  color: #667eea;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s ease;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.login-btn.loading {
  opacity: 0.8;
}

.loading-spinner {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 底部区域 */
.footer-section {
  text-align: center;
  margin-top: 40rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #999;
}

/* 验证码相关样式 */
.captcha-group {
  position: relative;
}

.captcha-group .input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
  margin-bottom: 0;
}

.captcha-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 44rpx;
  line-height: 44rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.captcha-display {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
  z-index: 10;
}

.captcha-number {
  min-width: 140rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
  padding: 0 20rpx;
}

.captcha-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  line-height: 1.2;
}

.captcha-loading {
  width: 120rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.captcha-refresh {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.captcha-refresh:active {
  background: #e8f0fe;
  transform: scale(0.95);
}

.captcha-refresh .icon-text {
  font-size: 24rpx;
  color: #667eea;
}
